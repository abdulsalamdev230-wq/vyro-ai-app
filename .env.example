# VYRO AI — Environment configuration template
# Copy this file to .env and fill in real values. NEVER commit real keys.

# --- AI Providers (leave empty to show honest "unavailable" states) ---
OPENAI_API_KEY=
RUNWARE_API_KEY=
STABILITY_API_KEY=
FAL_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_TTS_API_KEY=
ASSEMBLY_AI_API_KEY=

# --- Backend REST API ---
# Android emulator uses 10.0.2.2 to reach host machine localhost.
API_BASE_URL=http://10.0.2.2:3000/api

# --- AdMob (empty = test/demo unit IDs) ---
ADMOB_APP_ID=
ADMOB_BANNER_UNIT_ID=
ADMOB_INTERSTITIAL_UNIT_ID=
ADMOB_REWARDED_UNIT_ID=

# --- Firebase (also requires google-services.json in android/app/) ---
FIREBASE_PROJECT_ID=vyro-ai

# --- Social Auth credentials (leave empty for honest "unavailable" states) ---
# Google: OAuth 2.0 Web Client ID from Google Cloud Console
GOOGLE_WEB_CLIENT_ID=
# Facebook: App ID from Meta for Developers
FACEBOOK_APP_ID=
# Apple: Services ID from Apple Developer (Sign in with Apple)
APPLE_SERVICES_ID=
