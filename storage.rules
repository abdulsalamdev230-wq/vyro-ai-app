rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // =========================================================================
    // PROFILE PICTURES
    // Path: users/{uid}/profile/{fileName}
    // =========================================================================
    match /users/{uid}/profile/{fileName} {
      allow read: if true; // profile pictures are public
      allow write: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // =========================================================================
    // CHARACTER REFERENCE IMAGES
    // Path: users/{uid}/characters/{fileName}
    // =========================================================================
    match /users/{uid}/characters/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // =========================================================================
    // STORY IMAGES AND AUDIO
    // Path: users/{uid}/stories/{storyId}/{fileName}
    // =========================================================================
    match /users/{uid}/stories/{storyId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // =========================================================================
    // GENERATED VIDEOS
    // Path: users/{uid}/videos/{videoId}/{fileName}
    // =========================================================================
    match /users/{uid}/videos/{videoId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // =========================================================================
    // VIDEO THUMBNAILS
    // Path: users/{uid}/videos/{videoId}/thumb/{fileName}
    // =========================================================================
    match /users/{uid}/videos/{videoId}/thumb/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // =========================================================================
    // GENERATED IMAGES
    // Path: users/{uid}/images/{imageId}/{fileName}
    // =========================================================================
    match /users/{uid}/images/{imageId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // =========================================================================
    // ADMIN ACCESS (bypass for admins)
    // =========================================================================
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null
        && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
